{
  "name": "angularjs-to-react-reference",
  "private": true,
  "version": "0.0.0",
  "description": "Reference migration of the AngularJS angular-phonecat tutorial app to React and TypeScript, one tested step at a time.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "postinstall": "node scripts/copy-libs.mjs",
    "start": "http-server ./app -a localhost -p 8000 -c-1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "angular": "1.8.0",
    "angular-animate": "1.8.0",
    "angular-resource": "1.8.0",
    "angular-route": "1.8.0",
    "bootstrap": "3.3.7",
    "jquery": "3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/angular": "1.8.9",
    "@types/node": "22.20.5",
    "http-server": "14.1.1",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
